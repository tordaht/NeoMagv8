{
  "name": "neomag",
  "version": "10.0.0",
  "private": true,
  "type": "module",
  "description": "Turkish language evolution in a bacterial colony, with an online comprehension model",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "npm run build && tsx tests/smoke.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run smoke",
    "sample": "tsx tools/sample.ts",
    "balance": "tsx tools/balance.ts",
    "experiment": "tsx tools/experiment.ts",
    "evolution": "tsx tools/evolution.ts"
  },
  "dependencies": {
    "chart.js": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "playwright": "^1.63.0",
    "tsx": "^4.20.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "language-evolution",
    "turkish",
    "morphology",
    "agent-based-simulation",
    "machine-learning"
  ]
}
